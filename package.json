{
  "name": "leauto",
  "description": "Triage recruiter pitches in LinkedIn messages and draft replies for you to review and send.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:all": "wxt build && wxt build -b edge",
    "zip": "wxt zip && wxt zip -b edge",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "lint:fixtures": "node scripts/lint-fixtures.mjs",
    "check": "npm run typecheck && npm run lint:fixtures && npm test && npm run test:e2e",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
